{
  "name": "key-tuner",
  "version": "1.2.0",
  "description": "Password generator",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "test": "npm run test -w web && cargo test --workspace",
    "build:wasm": "cd crates/web && wasm-pack build --release --target web --out-dir ../../web/src/js/wasm_artifacts/pkg",
    "clean": "rm -rf web/dist web/src/js/wasm_artifacts/pkg"
  },
  "keywords": [
    "password",
    "generator",
    "wasm",
    "rust"
  ],
  "author": "shun@getto.systems",
  "license": "GPL-3.0",
  "devDependencies": {
  }
}